# Stage 4: ls, cd, wc, echo with the VFS. Run it with
#   ./run.sh --vfs examples/vfs/deep.xml --script examples/startup/stage4_commands.emu
# echo: arguments are joined by single spaces.
echo Hello,   emulator!
echo
# ls: root, a path, long format, hidden files, several operands.
ls
ls home
ls -l home/user
ls -a home/guest
ls -la /home/guest
ls /bin readme.txt home/user/docs
# cd: relative, absolute, "..", without arguments.
cd home/user/docs
ls
cd drafts
ls -l
cd ../../../..
ls
cd home/user
cd
# wc: all counters, selected counters, several files, binary file.
wc readme.txt
wc -l readme.txt
wc -w home/user/notes.txt
wc -c home/user/notes.txt
wc -lw readme.txt home/user/notes.txt
wc bin/tool.bin
# Errors stop the script: no such directory.
cd nosuch
echo never printed
